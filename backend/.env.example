PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=raksha_farms
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# CORS
ADMIN_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Admin login password. Server-side only — never mirror this into a frontend
# VITE_* variable. Set a real value in the Render dashboard; this file is a
# template and must not carry the live secret.
ADMIN_SECRET=change-me
