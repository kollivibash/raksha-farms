PORT=4000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Production (Neon): use the POOLED connection string — the host contains
# "-pooler". The pooled endpoint handles many short-lived connections, which is
# what a web server needs. TLS turns on automatically for *.neon.tech.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# Local development: leave DATABASE_URL unset and use the discrete vars below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=raksha_farms
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────────────────
ADMIN_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# ── Admin login ─────────────────────────────────────────────────────────────
# Server-side only — never mirror this into a frontend VITE_* variable.
# Set the real value in your host's dashboard; this file is a template.
ADMIN_SECRET=change-me

# ── Image uploads ───────────────────────────────────────────────────────────
# Set CLOUDINARY_URL in production. Without it, uploads go to the local ./uploads
# folder — which is fine locally, but on any host with an ephemeral filesystem
# every uploaded product image is silently destroyed on the next restart.
# Grab this value from Cloudinary → Dashboard → "API Environment variable".
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Payments (optional) ─────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── Google sign-in (optional) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
